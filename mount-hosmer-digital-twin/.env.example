# Mount Hosmer Avalanche Digital Twin -- environment template
# Copy to `.env` (same folder) and edit. Every value below is optional; the
# commented default is what the application uses when the variable is absent.

# ---------------------------------------------------------------------------
# Data locations
# ---------------------------------------------------------------------------
# Read-only source data (LiDAR, satellite, weather, snow, land cover, OSM).
# The application never writes here.
# Windows default: ..\DATA\mount_hosmer_data -- a sibling of this project folder.
AVALANCHE_DATA_ROOT=D:\school\capstone\Avalanche\DATA\mount_hosmer_data
# Linux / Docker:
# AVALANCHE_DATA_ROOT=/data/mount_hosmer_data

# Everything the application generates. Must NOT be inside AVALANCHE_DATA_ROOT.
# AVALANCHE_RUNTIME_ROOT=./runtime

# Derived analysis products (harmonized grids, terrain rasters, model outputs).
# AVALANCHE_DERIVED_DATA_ROOT=./runtime/derived

# Stored simulation events (one timestamped folder per run).
# AVALANCHE_SIMULATION_ROOT=./runtime/simulations

# Pre-1.0 names. Still honoured, but AVALANCHE_* takes precedence.
# MOUNT_HOSMER_DATA_ROOT=
# MOUNT_HOSMER_RUNTIME_ROOT=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Default is SQLite inside the runtime root, which is what the one-click
# launcher uses -- it needs no server. For a multi-user server deployment,
# point this at PostgreSQL (PostGIS optional but recommended):
#   DATABASE_URL=postgresql+psycopg://avalanche:secret@localhost:5432/avalanche
# DATABASE_URL=sqlite:///./runtime/avalanche.db

# Reserved for a future distributed job queue. Unset = in-process job runner.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production
# APP_ENV=development

# Comma-separated browser origins allowed to call the API.
# AVALANCHE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Analysis grids (metres)
# ---------------------------------------------------------------------------
# Terrain grid. Built from the 1 m BC LiDAR by area-averaging, so lowering this
# raises fidelity and cost quadratically. 5 m over the 12x12 km AOI is
# 2400x2400 px per layer. Do not raise it to 30 m: that discards the LiDAR.
# AVALANCHE_TERRAIN_RESOLUTION_M=5

# Environmental grid, matched to Sentinel-2 and ESA WorldCover native 10 m.
# AVALANCHE_ENVIRONMENTAL_RESOLUTION_M=10

# Fallback grid, matched to Copernicus GLO-30 and Landsat native 30 m. Used only
# where no LiDAR exists.
# AVALANCHE_FALLBACK_RESOLUTION_M=30

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# AVALANCHE_JOBS_ENABLED=true
# AVALANCHE_MAX_JOB_WORKERS=2
# Periodic refresh jobs. Off by default: this is an offline research prototype,
# so unattended network calls should be an explicit opt-in.
# AVALANCHE_SCHEDULER_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
