# Stage 3 backend image — TWO build targets from one file.
#
# The whole point of Stage 3 is that the running service has NO geospatial stack: it
# serves the pre-computed bake under runtime/baked/ with plain numpy. So this file
# builds two independent images:
#
#   --target bake     the ~6.5 GB LiDAR allow-list -> runtime/baked/. HAS rasterio,
#                     pyproj, pillow, pyyaml. Runs `python -m app.bake` once, then exits.
#   --target runtime  serves the API. Slim: fastapi/uvicorn/pydantic/numpy/scipy/
#                     shapely/httpx and NOTHING geospatial. `import app.main` must not
#                     pull rasterio -- the build asserts exactly that.
#
# `--only-binary=:all:` is deliberate in both: if a dependency has no wheel the build
# FAILS rather than quietly compiling from source and adding a toolchain to the image.

# ===========================================================================
# bake target -- offline, one-time. Reads DATA\ (mounted :ro), writes runtime\baked\.
# ===========================================================================
FROM python:3.13-slim AS bake

# libexpat1: required by the GDAL bundled inside the rasterio wheel. Without it,
# `import rasterio` dies at run time even though pip "succeeded".
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# requirements-bake.txt includes requirements.txt via `-r`, so copy both.
COPY backend/requirements.txt backend/requirements-bake.txt /tmp/
RUN pip install --only-binary=:all: -r /tmp/requirements-bake.txt

# WORKDIR is the PROJECT ROOT, not backend/. The app/__init__.py pkgutil shim extends
# the `app` package onto backend/app, which is why `python -m app.bake` resolves.
WORKDIR /app
ENV PYTHONPATH=/app
COPY app/ /app/app/
COPY backend/ /app/backend/
COPY pyproject.toml /app/pyproject.toml

# Prove the shim resolves and the geospatial stack imports, at BUILD time.
RUN python -c "import app.bake; import rasterio, pyproj, PIL, yaml; print('bake image ok, GDAL', rasterio.__gdal_version__)"

ENV AVALANCHE_DATA_ROOT=/data/mount_hosmer_data \
    AVALANCHE_RUNTIME_ROOT=/runtime
RUN useradd --create-home --uid 10001 avalanche && mkdir -p /runtime /data && chown -R avalanche:avalanche /runtime
USER avalanche
# One-shot: build the bake if runtime/baked is empty, then exit 0.
CMD ["python", "-m", "app.bake"]

# ===========================================================================
# runtime target -- serves the API from runtime\baked\. NO geospatial stack.
# ===========================================================================
FROM python:3.13-slim AS runtime

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Runtime deps ONLY. No rasterio, no pyproj -> no libexpat, no GDAL, no compiler.
COPY backend/requirements.txt /tmp/
RUN pip install --only-binary=:all: -r /tmp/requirements.txt

WORKDIR /app
ENV PYTHONPATH=/app
COPY app/ /app/app/
COPY backend/ /app/backend/
COPY pyproject.toml /app/pyproject.toml

# Prove app.main imports AND that the geospatial stack did NOT leak into this image.
RUN python -c "import importlib.util as u; import app.main; assert u.find_spec('rasterio') is None and u.find_spec('pyproj') is None, 'geospatial stack leaked into the runtime image'; print('runtime image ok: slim, rasterio-free')"

ENV AVALANCHE_DATA_ROOT=/data/mount_hosmer_data \
    AVALANCHE_RUNTIME_ROOT=/runtime \
    APP_ENV=production
RUN useradd --create-home --uid 10001 avalanche && mkdir -p /runtime /data && chown -R avalanche:avalanche /runtime
USER avalanche

EXPOSE 8000

# Liveness. The service is useless until the bake exists, but that is "unbuilt", not
# "broken" -- /api/health reports `baked: false` and stays up so it can tell you so.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

# Exec form: uvicorn is PID 1 and gets SIGTERM directly. No job queue to drain -- an
# assessment runs and returns inside one request -- so a short grace period is fine.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
