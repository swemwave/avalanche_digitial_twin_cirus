# Stage 3 backend image — TWO build targets from one file.
#
# The whole point of Stage 3 is that the running service has NO geospatial stack: it
# serves the pre-computed bake under runtime/baked/ with plain numpy. So this file
# builds two independent images:
#
#   --target bake     the ~6.5 GB LiDAR allow-list -> runtime/baked/. HAS rasterio,
#                     pyproj, pillow, pyyaml. Runs `python -m app.bake` once, then exits.
#   --target runtime  serves the API. Slim: fastapi/uvicorn/pydantic/numpy/scipy/
#                     shapely/httpx and NOTHING geospatial. `import app.main` must not
#                     pull rasterio -- the build asserts exactly that.
#
# `--only-binary=:all:` is deliberate in both: if a dependency has no wheel the build
# FAILS rather than quietly compiling from source and adding a toolchain to the image.

# ===========================================================================
# bake target -- offline, one-time. Reads DATA\ (mounted :ro), writes runtime\baked\.
# ===========================================================================
FROM python:3.13-slim AS bake

# libexpat1: required by the GDAL bundled inside the rasterio wheel. Without it,
# `import rasterio` dies at run time even though pip "succeeded".
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
# requirements-bake.txt includes requirements.txt via `-r`, so copy both.
COPY backend/requirements.txt backend/requirements-bake.txt /tmp/
# requirements.txt installs the canonical repository copy of AvyCore.
COPY packages/avycore /app/packages/avycore
RUN pip install --only-binary=:all: -r /tmp/requirements-bake.txt

# WORKDIR is the PROJECT ROOT, not backend/. The app/__init__.py pkgutil shim extends
# the `app` package onto backend/app, which is why `python -m app.bake` resolves.
ENV PYTHONPATH=/app
COPY app/ /app/app/
COPY backend/ /app/backend/
COPY pyproject.toml /app/pyproject.toml

# Prove the shim resolves and the geospatial stack imports, at BUILD time.
RUN python -c "import app.bake; import rasterio, pyproj, PIL, yaml; print('bake image ok, GDAL', rasterio.__gdal_version__)"

ENV AVALANCHE_DATA_ROOT=/data/mount_hosmer_data \
    AVALANCHE_RUNTIME_ROOT=/runtime
RUN useradd --create-home --uid 10001 avalanche && mkdir -p /runtime /data && chown -R avalanche:avalanche /runtime
USER avalanche
# One-shot: build the bake if runtime/baked is empty, then exit 0.
CMD ["python", "-m", "app.bake"]

# ===========================================================================
# bakeworker target -- the 4th microservice. FROM bake: the only image with
# rasterio/pyproj/PIL/pyyaml. Reachable only inside the VPC (no ALB, no CORS) --
# it is how the always-slim `assess` service delegates uploaded-mountain probe
# and bake work over HTTP instead of a local subprocess it cannot run itself.
# ===========================================================================
FROM bake AS bakeworker

# `bake` already ends as USER avalanche with app/ and backend/ copied in, so this
# needs no COPY and no USER toggling -- it only proves the new entrypoint imports.
RUN python -c "import app.main_bakeworker; print('bakeworker image ok')"

EXPOSE 8080
# No `/api` prefix here, unlike assess/assistant: this service is never reached
# through the ALB, so its routes -- including this health check -- do not carry one.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8080')}/health\", timeout=4).status == 200 else 1)"
CMD ["sh", "-c", "exec uvicorn app.main_bakeworker:app --host 0.0.0.0 --port ${PORT:-8080}"]

# ===========================================================================
# runtime target -- serves the API from runtime\baked\. NO geospatial stack.
# ===========================================================================
FROM python:3.13-slim AS runtime

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Runtime deps ONLY. No rasterio, no pyproj -> no libexpat, no GDAL, no compiler.
WORKDIR /app
COPY backend/requirements.txt /tmp/
COPY packages/avycore /app/packages/avycore
RUN pip install --only-binary=:all: -r /tmp/requirements.txt

ENV PYTHONPATH=/app
COPY app/ /app/app/
COPY backend/ /app/backend/
COPY pyproject.toml /app/pyproject.toml

# Prove app.main imports AND that the geospatial stack did NOT leak into this image.
RUN python -c "import importlib.util as u; import app.main; assert u.find_spec('rasterio') is None and u.find_spec('pyproj') is None, 'geospatial stack leaked into the runtime image'; print('runtime image ok: slim, rasterio-free')"

ENV AVALANCHE_DATA_ROOT=/data/mount_hosmer_data \
    AVALANCHE_RUNTIME_ROOT=/runtime \
    APP_ENV=production
RUN useradd --create-home --uid 10001 avalanche && mkdir -p /runtime /data && chown -R avalanche:avalanche /runtime
USER avalanche

EXPOSE 8000

# Liveness. The service is useless until the bake exists, but that is "unbuilt", not
# "broken" -- /api/health reports `baked: false` and stays up so it can tell you so.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

# Exec form: uvicorn is PID 1 and gets SIGTERM directly. No job queue to drain -- an
# assessment runs and returns inside one request -- so a short grace period is fine.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ===========================================================================
# assess target -- terrain + tiles + the assessment model. The HEAVY half.
# ===========================================================================
# Carries the baked artifacts, and is the only service that computes a release-potential
# number (and therefore the only one that has to attach the DISCLAIMER).
#
# WHY THE DATA IS BAKED INTO THE IMAGE, not mounted:
#   runtime/ is gitignored, so the baked artifacts exist only on the machine that
#   ran the bake. Copying them in makes the image self-contained and versioned
#   with the code that reads them -- a meta.json/reader mismatch is a whole class
#   of bug that cannot happen if they ship together. It also means no bucket to
#   mount, and a cold start that is just "pull the image".
#
# Consequence: build this where runtime/baked/ exists (i.e. locally, after
# `python -m app.bake`) and push the image. A source-based cloud build has no
# baked data to copy and would produce an image that reports `baked: false`.
FROM runtime AS assess

# Its own layer, and the LAST one, so editing code re-pushes a few KB rather than
# re-pushing 188 MB of terrain.
COPY --chown=avalanche:avalanche runtime/baked /runtime/baked

# Fail the build rather than ship a missing, stale, or corrupted scientific bake.
RUN python -m app.check_bake

EXPOSE 8080
# Cloud Run injects $PORT and ignores EXPOSE. `sh -c` with `exec` keeps uvicorn as
# PID 1 so it still receives SIGTERM directly; the default keeps `docker run` working.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8080')}/api/health\", timeout=4).status == 200 else 1)"
CMD ["sh", "-c", "exec uvicorn app.main_assess:app --host 0.0.0.0 --port ${PORT:-8080}"]

# ===========================================================================
# assistant target -- the local AI, and nothing else. The LIGHT half.
# ===========================================================================
# No baked artifacts, no terrain, no hazard computation. When a scenario question
# needs an assessment it calls the assess service (AVALANCHE_ASSESS_URL). Both
# upstreams -- that and Ollama (AVALANCHE_OLLAMA_URL) -- degrade to a clean 503.
#
# This image is deliberately identical to `runtime` plus a different entrypoint:
# the size difference between the two services is the DATA, not the code.
FROM runtime AS assistant

# Pin the split: this service must not be able to load the terrain reader or the
# runout engine. `app/api/__init__.py` importing every router once made that false.
RUN python -c "import sys, app.main_assistant; bad=[m for m in ('app.assess','app.simulation.runout','app.api.terrain') if m in sys.modules]; sys.exit(f'heavy modules leaked into the assistant image: {bad}') if bad else print('assistant image ok: no terrain, no runout')"

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8080')}/api/health\", timeout=4).status == 200 else 1)"
CMD ["sh", "-c", "exec uvicorn app.main_assistant:app --host 0.0.0.0 --port ${PORT:-8080}"]
